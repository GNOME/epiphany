using Gtk 4.0;
using Adw 1;

menu overview_menu {
  section {
    item {
      label: _("_New Window");
      action: "app.new-window";
    }

    item {
      label: _("New _Incognito Window");
      action: "app.new-incognito";
    }
  }

  section {
    item {
      label: _("Reopen Closed _Tab");
      action: "app.reopen-closed-tab";
    }

    item {
      label: _("Close _All Tabs");
      action: "app.close-all-tabs";
    }
  }
}

template $EphyWindow: Adw.ApplicationWindow {
  width-request: 360;
  height-request: 200;
  notify::fullscreened => $notify_fullscreen_cb();

  Adw.Breakpoint {
    condition ("max-width: 600px")

    setters {
      template.adaptive-mode: EPHY_ADAPTIVE_MODE_NARROW;
    }
  }

  content: Adw.OverlaySplitView overlay_split_view {
    max-sidebar-width: 360;
    collapsed: true;
    show-sidebar: false;
    sidebar-position: end;
    notify::show-sidebar => $show_sidebar_cb() swapped;

    content: Adw.TabOverview overview {
      enable-new-tab: true;
      secondary-menu: overview_menu;
      notify::open => $notify_overview_open_cb() swapped;
      create-tab => $create_tab_cb() swapped;

      child: $EphyFullscreenBox fullscreen_box {};
    };

    sidebar: $EphyBookmarksDialog bookmarks_dialog {};
  };

  GesturePan {
    orientation: vertical;
    propagation-phase: capture;
    pan => $pan_cb() swapped;
  }
}
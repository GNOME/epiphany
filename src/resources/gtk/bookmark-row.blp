using Gtk 4.0;
using Adw 1;

menu move_menu {
  section {
    item {
      label: _("Move Up");
      action: "row.move-up";
    }

    item {
      label: _("Move Down");
      action: "row.move-down";
    }
  }
}

template $EphyBookmarkRow: Adw.ActionRow {
  title-lines: 1;
  use-markup: false;
  activatable: true;
  activated => $on_row_activated();

  [prefix]
  Image favicon_image {
    pixel-size: 16;
  }

  [prefix]
  Image drag_handle {
    icon-name: "list-drag-handle-symbolic";

    DragSource {
      actions: move;
      prepare => $drag_prepare_cb() swapped;
      drag-begin => $drag_begin_cb() swapped;
    }
  }

  [suffix]
  Button remove_button {
    icon-name: "user-trash-symbolic";
    receives-default: false;
    tooltip-text: _("Remove");
    valign: center;
    clicked => $ephy_bookmark_row_remove_button_clicked_cb() swapped;

    styles [
      "flat",
    ]
  }

  [suffix]
  Button properties_button {
    icon-name: "document-edit-symbolic";
    receives-default: false;
    tooltip-text: _("Properties");
    valign: center;
    clicked => $ephy_bookmark_row_properties_button_clicked_cb() swapped;

    styles [
      "flat",
    ]
  }

  [suffix]
  MenuButton move_menu_button {
    icon-name: "view-more-symbolic";
    receives-default: false;
    tooltip-text: _("Move Controls");
    valign: center;
    menu-model: move_menu;

    styles [
      "flat",
    ]
  }

  DropTarget {
    formats: "AdwActionRow";
    actions: move;
    preload: true;
    drop => $drop_cb() swapped;
  }
}

using Gtk 4.0;
using Adw 1;

template $EphyFullscreenBox: Adw.Bin {
  child: Adw.ToolbarView toolbar_view {
    top-bar-style: raised_border;
    bottom-bar-style: raised_border;
    notify::reveal-top-bars => $notify_reveal_cb() swapped;
  };

  EventControllerMotion {
    propagation-phase: capture;
    enter => $enter_cb() swapped;
    motion => $motion_cb() swapped;
  }

  GestureClick {
    propagation-phase: capture;
    touch-only: true;
    pressed => $press_cb();
  }
}
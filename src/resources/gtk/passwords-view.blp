using Gtk 4.0;
using Adw 1;

template $EphyPasswordsView: Adw.Dialog {
  content-width: 640;
  content-height: 580;

  $EphyDataView data_view {
    title: _("Passwords");
    search-description: _("Search passwords");
    empty-title: _("No Passwords Found");
    empty-description: _("Saved passwords will be listed here");
    can-clear: "True";
    clear-button: clear_button;
    notify::search-text => $on_search_text_changed() swapped;

    [top-end]
    MenuButton {
      icon-name: "view-more-symbolic";
      tooltip-text: _("Options");
      menu-model: options_menu;
    }

    Box {
      orientation: vertical;

      ScrolledWindow {
        width-request: 300;
        height-request: 300;
        vexpand: true;
        min-content-width: 300;
        min-content-height: 300;

        Adw.Clamp {
          margin-start: 6;
          margin-end: 6;

          ListBox listbox {
            margin-top: 6;
            margin-bottom: 6;
            valign: start;
            selection-mode: multiple;
            activate-on-single-click: false;

            styles [
              "boxed-list",
            ]
          }
        }
      }
    }

    [bottom-end]
    Button clear_button {
      label: _("_Clear All");
      use-underline: true;
      tooltip-text: _("Remove All Passwords");
      clicked => $on_clear_button_clicked() swapped;

      styles [
        "destructive-action",
      ]
    }
  }
}

menu treeview_popup_menu_model {
  section {
    item {
      label: _("_Copy Password");
      action: "passwords.copy-password";
    }

    item {
      label: _("C_opy Username");
      action: "passwords.copy-username";
    }
  }
}

menu options_menu {
  section {
    item {
      label: _("_Import…");
      action: "app.import-passwords";
    }

    item {
      label: _("_Export…");
      action: "app.export-passwords";
    }
  }
}

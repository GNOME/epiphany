msgstr ""
"Om eit nytt vindauge som ikkje er gjenoppretta frå ei tidlegare økt, skal "
"vere maksimert frå starten."

#: data/org.gnome.epiphany.gschema.xml:365
msgid "Disable forward and back buttons"
msgstr "Slå av framover- og bakoverknappar"

#: data/org.gnome.epiphany.gschema.xml:366
